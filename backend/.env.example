# Neon PostgreSQL Connection String
# Format: postgresql+asyncpg://<username>:<password>@<neon-hostname>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# JWT Secret
SECRET_KEY=homecare-secure-jwt-secret-key-2026-production-ready-min32

# Token Expiry (in minutes, 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
